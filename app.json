{
  "package_id": "com.marklysze.mygithub",
  "edition": "202601",
  "name": "My GitHub",
  "version": "0.1.0",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.10",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Fetch your open pull requests from GitHub.",
      "whitelist": [
        "https://api.github.com",
        "https://my-prs-github-proxy.my-github-even.workers.dev"
      ]
    }
  ],
  "supported_languages": ["en"]
}
